# Langfuse Configuration (Get these from your Langfuse dashboard)
LANGFUSE_SECRET_KEY="sk-lf-..."
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_HOST="https://cloud.langfuse.com" # Or your local Langfuse URL

# LiteLLM / Inference Configuration
# When deployed, this hits the local LiteLLM gateway routing to your 3070ti or CPU nodes
LLM_BASE_URL="http://litellm.default.svc.cluster.local:4000/v1"
LLM_MODEL="openai:hosted-sglang-model" # The model name configured in LiteLLM

# Authentication (If LiteLLM requires it, otherwise leave blank or dummy)
LLM_API_KEY="dummy-key"
